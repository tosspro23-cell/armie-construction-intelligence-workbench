APP_ENV=development
DATA_DIR=./demo_data
IFC_FILE=armie_demo.ifc
PDF_FILE=armie_demo_schedule.pdf

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen3-vl:8b
# Optional bounded escalation for persistent semantic-plan validation
# failures. Disabled by default (opt-in): no developer or CI environment
# is silently required to hold a large local model. Set to a locally
# available Ollama model (e.g. qwen3:30b) to enable.
OLLAMA_ESCALATION_MODEL=
REQUEST_TIMEOUT_SECONDS=180
MODEL_CALL_TIMEOUT_SECONDS=90

# Azure OpenAI (SPEC-M3 Phase 1). Only used when LLM_PROVIDER=azure.
# Managed Identity only (OD-23): there is no API-key field here by design.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_TEXT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o-mini

# OpenTelemetry export target. Empty means telemetry is a local no-op.
OTEL_EXPORTER_CONNECTION_STRING=

CHECKPOINT_DB_PATH=./runtime/checkpoints.sqlite
AUDIT_STORE_PATH=./runtime/audit.jsonl
EVIDENCE_DIR=./runtime/evidence
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=armie-construction-intelligence-workbench
