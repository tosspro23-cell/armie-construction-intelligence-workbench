server {
    listen 80;
    server_name _;

    # Reverse-proxies the API through this same origin so the browser never
    # makes a cross-origin request -- this is why apps/api's CORS policy
    # does not need to change for the cloud profile (SPEC-M3 §4E/§7).
    # ${API_BACKEND_URL} is substituted at container start by the official
    # nginx:alpine image's built-in envsubst-on-templates entrypoint step
    # (/etc/nginx/templates/*.template -> /etc/nginx/conf.d/*.conf); the
    # rendered config is static by the time nginx starts, so no runtime
    # `resolver` directive is needed here.
    location /api/ {
        proxy_pass ${API_BACKEND_URL}/api/;
        proxy_http_version 1.1;
        # nginx's own default (60s) is shorter than the backend's
        # request_timeout_seconds (180s, apps/api/app/config.py) -- a
        # legitimate slow model/vision call would get a 504 from nginx
        # while the backend was still working and would have returned its
        # own structured timeout/answer. Independent review finding;
        # matched to the backend's default, not just raised arbitrarily.
        proxy_connect_timeout 180s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        # $proxy_host, not $host: Azure Container Apps' ingress edge routes
        # an internal-only app's HTTPS traffic by the target app's own
        # hostname (SNI + Host header), not the caller's -- forwarding this
        # web app's own $host here made the edge unable to route to the API
        # app at all (verified live during SPEC-M3's first real deployment:
        # this and the missing SNI below were the actual cause of a 502,
        # not a DNS or connectivity problem).
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Required because API_BACKEND_URL is https: nginx does not send
        # the TLS SNI extension by default, and Azure's Envoy-based ingress
        # edge needs it to route to the correct internal Container App.
        proxy_ssl_server_name on;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri /index.html;
    }
}
